<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2" >
    <br><br>
    <h3>Create a New Listing</h3>
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
            <div class="valid-feedback">Title looks good</div>
        </div>

        <div class="mb-3">
            <lable for="description" class="form-label">description</lable>
            <textarea 
                name="listing[description]" 
                class="form-control"
                required
                ></textarea>
                <div class="invalid-feedback">please enter a valid description</div>
        </div>

        <div class="mb-3">
            <lable for="image" class="form-label">Upload Listing Image</lable>
            <input name="listing[image]" type="file" class="form-control" required>
            <div class="invalid-feedback">please enter a valid image link</div>
        </div>

        <div class="row">
            <div class="mb-3 col-4">
                <lable for="price" class="form-label">Price</lable>
                <input name="listing[price]" placeholder="1500" class="form-control" required>
                <div class="invalid-feedback">please enter valid price</div>
            </div>

            <div class="mb-3 col-8">
                <lable for="country" class="form-label">Country</lable>
                <input name="listing[country]" placeholder="India" type="text" class="form-control" required> 
                <div class="invalid-feedback">please enter valid country</div>
            </div>
        </div>
        
        <div class="mb-3">
           <lable for="location" class="form-label">Location</lable> 
           <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
           <div class="valid-feedback">please enter valid location</div>
        </div>
    
        
        <button class="btn btn-dark add-btn mt-3">add</button>
        

    </form>
    </div>
</div>